{
  "name": "talminal",
  "version": "0.2.0",
  "description": "Tal med dine terminaler. Stemmestyret canvas af agent-terminaler (Claude Code / Codex CLI) til Windows.",
  "license": "Apache-2.0",
  "author": "Robin Witzner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RWitzner/talminal.git"
  },
  "bugs": {
    "url": "https://github.com/RWitzner/talminal/issues"
  },
  "homepage": "https://github.com/RWitzner/talminal#readme",
  "bin": {
    "talminal": "bin/talminal.mjs"
  },
  "files": [
    "bin/",
    "vendor/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "ASSETS.md"
  ],
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/assert-perf-bundle.mjs off",
    "build:perf": "tsc && vite build --mode perf && node scripts/assert-perf-bundle.mjs on",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "happy-dom": "^20.11.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
